# Application
WEBHACKING_ENVIRONMENT=development
WEBHACKING_LOG_LEVEL=INFO
WEBHACKING_API_HOST=0.0.0.0
WEBHACKING_API_PORT=8000
WEBHACKING_FRONTEND_PORT=8080
WEBHACKING_DATABASE_URL=sqlite+aiosqlite:///./data/webhacking_lab.db
WEBHACKING_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Safety defaults. Network execution also requires workspace-level approval.
WEBHACKING_ANALYSIS_ONLY=true
WEBHACKING_NETWORK_EXECUTION_ENABLED=false
WEBHACKING_ALLOW_INSECURE_TLS=false
WEBHACKING_GLOBAL_REQUESTS_PER_MINUTE=30
WEBHACKING_DEFAULT_TARGET_CONCURRENCY=2
WEBHACKING_REQUEST_TIMEOUT_SECONDS=10
WEBHACKING_MAX_RESPONSE_BYTES=2097152

# Frontend (used for local Vite development; Docker uses the same-origin proxy)
VITE_API_BASE_URL=http://localhost:8000/api
